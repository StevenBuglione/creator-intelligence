# Documentation only. On Windows run scripts/init-local.ps1 to generate private
# credentials outside Git, then scripts/with-local-env.ps1 to load them.
APP_MODE=live
APP_ORIGIN=http://localhost:4310
API_ORIGIN=http://localhost:4311
GOOGLE_PROJECT_NUMBER=YOUR_NUMERIC_PROJECT_NUMBER
OWNED_CHANNEL_ID=YOUR_CHANNEL_ID
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4311/api/v1/auth/google/callback
GENERAL_DAILY_BUDGET=9000
SEARCH_DAILY_BUDGET=90
BATCH_DAILY_BUDGET=9000
BACKUP_RETENTION_DAYS=7
# Private generated values required: DATABASE_URL, DB_PASSWORD,
# APP_ENCRYPTION_KEY (32 random bytes, base64), OWNER_PASSWORD, MCP_TOKEN,
# WORKER_TOKEN, CI_SECRET_DIR, CI_ENV_FILE.
# Optional local inference: LOCAL_LLM_BASE_URL, LOCAL_LLM_MODEL.
# Blueprints export as local JSON files. No external production receiver is configured.
